# ── Server ────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# ── Auth (Mac ↔ public API) ───────────────────────────────
# Leave empty for local dev. For Railway, generate one:
#   openssl rand -hex 32
VAULT_API_KEY=

# Mac agent points here. Use the Railway URL once deployed.
VAULT_API_BASE=http://127.0.0.1:8000

# ── Postgres ──────────────────────────────────────────────
# Local dev: set the parts below. Railway sets DATABASE_URL automatically and it wins.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=vault_zeta
POSTGRES_USER=vault
POSTGRES_PASSWORD=change-me
# DATABASE_URL=postgres://...      # injected by Railway when present

# ── LLM (chat) — Groq by default ──────────────────────────
# provider: "openai" (any OpenAI-compatible endpoint) or "ollama" (local-dev)
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.groq.com/openai/v1
# Comma-separated list of keys — rotates on 429 / 401. Single key is fine too.
#   LLM_API_KEY=gsk_aaa,gsk_bbb,gsk_ccc
LLM_API_KEY=
# Verify against https://console.groq.com/docs/models — Gemma model name rotates.
# Solid fallbacks: llama-3.3-70b-versatile, llama-3.1-8b-instant
LLM_MODEL=llama-3.3-70b-versatile

# ── Embeddings — local fastembed ONNX (no key, no rate limit) ─
# To use a hosted provider instead, set EMBED_PROVIDER=openai and point
# EMBED_BASE_URL / EMBED_API_KEY / EMBED_MODEL / EMBED_DIM at it.
EMBED_PROVIDER=local
EMBED_BASE_URL=
EMBED_API_KEY=
EMBED_MODEL=BAAI/bge-small-en-v1.5
EMBED_DIM=384
RETRIEVAL_K=8
RECENT_MESSAGE_WINDOW=12

# ── STT — Groq Whisper by default ─────────────────────────
STT_PROVIDER=groq
STT_BASE_URL=https://api.groq.com/openai/v1
# Same comma-separated rotation. Often same as LLM_API_KEY (both hit Groq).
STT_API_KEY=
STT_MODEL=whisper-large-v3-turbo

# ── TTS (ElevenLabs) ──────────────────────────────────────
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128

# ── Identity / mission ────────────────────────────────────
USER_HANDLE=karnveer
MISSION_TARGET_DATE=2026-11-23
MISSION_STATEMENT=Achieve financial freedom

# ── Gmail connector (optional) ────────────────────────────
# JSON token blob from scripts/gmail_auth.py.
# If unset, the gmail connector and Email expert are silently absent.
# Run once: python scripts/gmail_auth.py --client-secrets /path/to/client_secret.json
GOOGLE_CREDENTIALS_JSON=

# ── Optional: local Ollama (LLM_PROVIDER=ollama) ──────────
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma3:latest
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_KEEP_ALIVE=30m

# ── Optional: local Whisper (STT_PROVIDER=local) ──────────
WHISPER_MODEL=small.en
WHISPER_COMPUTE_TYPE=int8
WHISPER_DEVICE=auto
