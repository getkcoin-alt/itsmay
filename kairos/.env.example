# Required: never reuse the local default admin password on a shared host.
KAIROS_ADMIN_PASSWORD=change-me-Strong!Pass1
POSTGRES_PASSWORD=change-me
# Set true when served over HTTPS.
KAIROS_COOKIE_SECURE=false
# Demo-only: show password-reset links in the UI (no outbound email exists).
KAIROS_EXPOSE_RESET_LINKS=false
