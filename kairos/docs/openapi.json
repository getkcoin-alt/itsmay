 "components": {
  "schemas": {
   "AssetPatch": {
    "properties": {
     "enabled": {
      "anyOf": [
       {
        "type": "boolean"
       },
       {
        "type": "null"
       }
      ],
      "title": "Enabled"
     },
     "target_price": {
      "anyOf": [
       {
        "type": "number",
        "exclusiveMinimum": 0.0
       },
       {
        "type": "string",
        "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$"
       },
       {
        "type": "null"
       }
      ],
      "title": "Target Price"
     },
     "clear_override": {
      "type": "boolean",
      "title": "Clear Override",
      "default": false
     },
     "volatility": {
      "anyOf": [
       {
        "type": "number",
        "maximum": 3.0,
        "minimum": 0.01
       },
       {
        "type": "string",
        "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$"
       },
       {
        "type": "null"
       }
      ],
      "title": "Volatility"
     }
    },
    "type": "object",
    "title": "AssetPatch"
   },
   "ChangePasswordIn": {
    "properties": {
     "current_password": {
      "type": "string",
      "title": "Current Password"
     },
     "new_password": {
      "type": "string",
      "maxLength": 128,
      "title": "New Password"
     }
    },
    "type": "object",
    "required": [
     "current_password",
     "new_password"
    ],
    "title": "ChangePasswordIn"
   },
   "DepositIn": {
    "properties": {
     "amount": {
      "anyOf": [
       {
        "type": "number",
        "exclusiveMinimum": 0.0
       },
       {
        "type": "string",
        "pattern": "^(?!^[-+.]*$)[+-]?0*(?:\\d{0,12}|(?=[\\d.]{1,15}0*$)\\d{0,12}\\.\\d{0,2}0*$)"
       }
      ],
      "title": "Amount"
     },
     "method": {
      "type": "string",
      "pattern": "^(SIM_UPI|SIM_NETBANKING|SIM_BANK)$",
      "title": "Method",
      "default": "SIM_UPI"
     }
    },
    "type": "object",
    "required": [
     "amount"
    ],
    "title": "DepositIn"
   },
   "ForgotIn": {
    "properties": {
     "email": {
      "type": "string",
      "maxLength": 255,
      "pattern": "^[^@\\s]+@[^@\\s]+\\.[A-Za-z]{2,}$",
      "title": "Email"
     }
    },
    "type": "object",
    "required": [
     "email"
    ],
    "title": "ForgotIn"
   },
   "HTTPValidationError": {
    "properties": {
     "detail": {
      "items": {
       "$ref": "#/components/schemas/ValidationError"
      },
      "type": "array",
      "title": "Detail"
     }
    },
    "type": "object",
    "title": "HTTPValidationError"
   },
   "KycDecision": {
    "properties": {
     "decision": {
      "type": "string",
      "pattern": "^(APPROVED|REJECTED)$",
      "title": "Decision"
     },
     "note": {
      "anyOf": [
       {
        "type": "string",
        "maxLength": 500
       },
       {
        "type": "null"
       }
      ],
      "title": "Note"
     }
    },
    "type": "object",
    "required": [
     "decision"
    ],
    "title": "KycDecision"
   },
   "KycIn": {
    "properties": {
     "legal_name": {
      "type": "string",
      "maxLength": 120,
      "minLength": 2,
      "title": "Legal Name"
     },
     "pan": {
      "type": "string",
      "pattern": "^[A-Z]{5}[0-9]{4}[A-Z]$",
      "title": "Pan",
      "description": "Dummy PAN-format value only"
     },
     "city": {
      "type": "string",
      "maxLength": 80,
      "minLength": 2,
      "title": "City"
     },
     "occupation": {
      "type": "string",
      "maxLength": 80,
      "minLength": 2,
      "title": "Occupation"
     },
     "income_band": {
      "type": "string",
      "maxLength": 40,
      "title": "Income Band"
     },
     "derivatives_experience": {
      "type": "string",
      "maxLength": 40,
      "title": "Derivatives Experience"
     },
     "acknowledge_simulated": {
      "type": "boolean",
      "title": "Acknowledge Simulated"
     }
    },
    "type": "object",
    "required": [
     "legal_name",
     "pan",
     "city",
     "occupation",
     "income_band",
     "derivatives_experience",
     "acknowledge_simulated"
    ],
    "title": "KycIn"
   },
   "LoginIn": {
    "properties": {
     "email": {
      "type": "string",
      "maxLength": 255,
      "pattern": "^[^@\\s]+@[^@\\s]+\\.[A-Za-z]{2,}$",
      "title": "Email"
     },
     "password": {
      "type": "string",
      "maxLength": 128,
      "title": "Password"
     }
    },
    "type": "object",
    "required": [
     "email",
     "password"
    ],
    "title": "LoginIn"
   },
   "OrderIn": {
    "properties": {
     "symbol": {
      "type": "string",
      "maxLength": 48,
      "minLength": 1,
      "title": "Symbol"
     },
     "side": {
      "type": "string",
      "pattern": "^(BUY|SELL)$",
      "title": "Side"
     },
     "order_type": {
      "type": "string",
      "pattern": "^(MARKET|LIMIT)$",
      "title": "Order Type",
      "default": "MARKET"
     },
     "quantity": {
      "anyOf": [
       {
        "type": "number",
        "exclusiveMinimum": 0.0
       },
       {
        "type": "string",
        "pattern": "^(?!^[-+.]*$)[+-]?0*(?:\\d{0,16}|(?=[\\d.]{1,25}0*$)\\d{0,16}\\.\\d{0,8}0*$)"
       },
       {
        "type": "null"
       }
      ],
      "title": "Quantity"
     },
     "lots": {
      "anyOf": [
       {
        "type": "integer",
        "maximum": 10000.0,
        "exclusiveMinimum": 0.0
       },
       {
        "type": "null"
       }
      ],
      "title": "Lots"
     },
     "limit_price": {
      "anyOf": [
       {
        "type": "number",
        "exclusiveMinimum": 0.0
       },
       {
        "type": "string",
        "pattern": "^(?!^[-+.]*$)[+-]?0*(?:\\d{0,16}|(?=[\\d.]{1,25}0*$)\\d{0,16}\\.\\d{0,8}0*$)"
       },
       {
        "type": "null"
       }
      ],
      "title": "Limit Price"
     },
     "client_order_id": {
      "anyOf": [
       {
        "type": "string",
        "maxLength": 64,
        "pattern": "^[A-Za-z0-9_\\-]+$"
