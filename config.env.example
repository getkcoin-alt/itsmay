# It's May — local config template.
# Copy to ~/.itsmay/config.env (the installer does this for you) and fill in.
# Real environment variables always override anything set here.

# ── Required: Groq (the brain + voice transcription) ───────────────
# Free key at https://console.groq.com/keys. The same key powers both the
# language model and Whisper speech-to-text. Comma-separate several keys to
# stack their daily token budgets (e.g. LLM_API_KEY=key1,key2,key3).
LLM_API_KEY=
STT_API_KEY=

# ── Optional: ElevenLabs (natural spoken replies) ──────────────────
# https://elevenlabs.io — without it, text chat still works; voice just won't
# speak back.
ELEVENLABS_API_KEY=

# ── Memory (sovereign by default) ──────────────────────────────────
# "auto" stores everything in a single local SQLite file (~/.itsmay/memory.db) —
# no server, no Docker. Only set DATABASE_URL if you deliberately want Postgres.
MEMORY_BACKEND=auto
# SQLITE_PATH=~/.itsmay/memory.db

# ── Claude Code (when the worker drives it) ────────────────────────
# Let Claude Code apply edits without a prompt for every change.
SCRAPPY_CLAUDE_FLAGS=--permission-mode acceptEdits
